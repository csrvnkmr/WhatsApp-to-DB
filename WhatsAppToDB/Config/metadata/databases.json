            { "key": "Database", "label": "Initial Catalog (Database Name)", "type": "text", "isRequired": true },
            { "key": "Username", "label": "User ID", "type": "text" },
            { "key": "Password", "label": "Password", "type": "password" },
            { "key": "TrustServerCertificate", "label": "Trust Server Certificate", "type": "boolean", "defaultValue": "false" }
          ],
          "PostgreSQL": [
            { "key": "Host", "label": "Host Address", "type": "text", "isRequired": true },
            { "key": "Port", "label": "Port", "type": "number", "defaultValue": "5432" },
            { "key": "Database", "label": "Database Name", "type": "text", "isRequired": true },
            { "key": "Username", "label": "Username", "type": "text", "isRequired": true },
            { "key": "Password", "label": "Password", "type": "password", "isRequired": true }
