{
  "entity": "vectordbsettings",
  "title": "Vector DB Settings",
  "targetFile": "vectordbsettings.json",
  "maxrecords": 1,
  "fields": [
    { 
      "name": "CacheFolder",
      "fulllength": true, 
      "required": true, 
      "label": "Cache Folder", "type": "text",
      "showinheader": true,
      "description": "Folder path for SQLite Data cache. Ensure this folder exists and is writable." 
    },

    { 
      "name": "EmbeddingServiceSettings.Type",
      "fulllength": true, 
      "label": "Embedding Service Type", "type": "select", 
      "showinheader": true,
      "options": ["ollama","jina","openai"],
      "description": "Select the embedding service type. 'local' uses a local model, 'jina' uses Jina AI API, and 'openai' uses OpenAI API." 
    },

    { 
      "name": "OllamaSettings.Model", "label": "Ollama Embedding Model", "fulllength": true, "type": "text",
      "showIf": {"EmbeddingServiceSettings.Type": { "op": "==", "value": "ollama" }},
      "description": "Specify the Ollama embedding model to use (e.g., 'sentence-transformers/all-MiniLM-L6-v2')." 
    },    
    { 
      "name": "OllamaSettings.Url", "label": "Ollama URL", "fulllength": true, "type": "text",
      "showIf": {"EmbeddingServiceSettings.Type": { "op": "==", "value": "ollama" }},
      "description": "Specify the Ollama server URL (e.g., 'http://localhost:11434')." 
    },
    { 
      "name": "OllamaSettings.ApiKey", "label": "Ollama API Key", "fulllength": true, "type": "password",
      "showIf": {"EmbeddingServiceSettings.Type": { "op": "==", "value": "ollama" }},
      "description": "Specify the Ollama API key." 
    },

    { "name": "OpenAiSettings.Model", "label": "OpenAI Embedding Model", "fulllength": true, "type": "text",
      "showIf": {"EmbeddingServiceSettings.Type": { "op": "==", "value": "openai" }} },
    { "name": "OpenAiSettings.ApiKey", "label": "OpenAI API Key", "fulllength": true, "type": "password",
      "showIf": {"EmbeddingServiceSettings.Type": { "op": "==", "value": "openai" }} },
      
    { 
      "name": "JinaAiSettings.ApiModel", "label": "Jina Embedding Model", "fulllength": true, "type": "text",
      "showIf": {"EmbeddingServiceSettings.Type": { "op": "==", "value": "jina" }} },
    { "name": "JinaAiSettings.URL", "label": "Jina API URL", "fulllength": true, "type": "text",
      "showIf": {"EmbeddingServiceSettings.Type": { "op": "==", "value": "jina" }} },
    { "name": "JinaAiSettings.ApiKey", "label": "Jina API Key", "fulllength": true, "type": "password",
      "showIf": {"EmbeddingServiceSettings.Type": { "op": "==", "value": "jina" }} },

    { "name": "VectorProviderSettings.Type", "label": "Vector DB Type", 
      "fulllength": true, "type": "select", "options": ["sqlite","chroma"] ,
      "showinheader": true},
    { "name": "SqliteSettings.VectorDBFolder", "label": "SQLite Folder for Vector DB", "fulllength": true, "type": "text",
      "showIf": {"VectorProviderSettings.Type": { "op": "==", "value": "sqlite" }},

      "description": "Folder path for SQLite vector DB files. Ensure this folder exists and is writable." },
    { "name": "ChromaSettings.ChromaUrl", "label": "Chroma URL", "fulllength": true, "type": "text",
      "showIf": {"VectorProviderSettings.Type": { "op": "==", "value": "chroma" }}  }
  ]
}