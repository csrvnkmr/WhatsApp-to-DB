{
  "entity": "defaultsettings",
  "title": "Default Settings",
  "targetFile": "defaultsettings.json",
  "maxrecords": 1,
  "fields": [
    {
      "name": "DefaultDatabase",
      "label": "Default Database",
      "type": "text",
      "showinheader": true,
      "required": true,
      "references": "databases.Name"
    },
    {
      "name": "DefaultLlmProvider",
      "label": "Default Llm Provider",
      "showinheader": true,
      "type": "text",
      "required": true,
      "references": "llms.Provider"
    },
    {
      "name": "DefaultLlmModel",
      "label": "Default Llm Model",
      "showinheader": true,
      "type": "text",
      "required": true,
      "filterby": {
        "sourcefield": "DefaultLlmProvider",
        "targetField": "llms.Provider"
      },
      "references": "llms.Models"
    },
    {
      "name": "MaxTurns",
      "label": "Maximum Turns ",
      "type": "number",
      "showinheader": true,
      "fulllength": true,
      "description": "Maximum number of previous conversion history to be sent to LLM for context"
    }
  ]
}