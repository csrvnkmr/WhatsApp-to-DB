{
  "entity": "metadata",
  "title": "Metadata Configuration",
  "targetFile": "metadata.json",
  "fields": [
    {
      "name": "entity",
      "label": "Entity Name",
      "type": "text",
      "showinheader": true,
      "required": true,
      "unique": true
    },
    {
      "name": "title",
      "label": "Title for the Entity",
      "type": "text",
      "showinheader": true,
      "required": true
    },
    {
      "name": "targetFile",
      "label": "Target File",
      "type": "text",
      "showinheader": true,
      "required": true
    },
    {
      "name": "maxrecords",
      "label": "Max Records",
      "type": "number",
      "showinheader": false,
      "required": false,
      "description": "Maximum number of records to store for this entity."
    },
    {
      "name": "fields",
      "label": "Field Definitions",
      "type": "array<object>",
      "showinheader": false,
        "fulllength": true,
      "required": true,
      "description": "List of fields that define the structure of this entity.",
      "properties": [
        {
          "name": "name",
          "label": "Field Name",
          "type": "text",
          "showinheader": true,
          "required": true
        },
        {
          "name": "label",
          "label": "Field Label",
          "type": "text",
          "showinheader": true,
          "required": true
        },
        {
          "name": "type",
          "label": "Field Data Type",
          "type": "select",
          "required": true,
          "showinheader": true,
          "options": ["text", "textarea", "password", "number", "date", "boolean", "select", "array<text>", "object", "array<object>"]
        },
        {
          "name": "options",
          "label": "Options (For Select dropdowns)",
          "type": "array<text>",
          "required": false,
          "fulllength": true,
          "description": "Add options if the field data type is 'select'",
          "showIf" : {"type": { "op": "==", "value": "select" }}
        },
        {
          "name": "showinheader",
          "label": "Show in Header",
          "type": "boolean",
          "required": false
        },
        {
          "name": "required",
          "label": "Required",
          "type": "boolean",
          "required": false
        },
        {
          "name": "sensitive",
          "label": "Is Sensitive",
          "type": "boolean",
          "required": false
        },
        {
          "name": "fulllength",
          "label": "Full Width Layout",
          "type": "boolean",
          "required": false
        },
        {
          "name": "description",
          "label": "Description / Tooltip",
          "type": "textarea",
          "fulllength": true,
          "required": false
        },
        {
          "name": "references",
          "label": "References (Foreign Key)",
          "type": "text",
          "fulllength": true,
          "required": false,
          "description": "Format: 'entityname.fieldname'"
        },
        {
          "name": "sourceScope",
          "label": "Source Scope",
          "type": "text",
          "fulllength": true,
          "required": false
        },
        {
          "name": "showIf",
          "label": "Show If Condition",
          "type": "object",
          "required": false,
          "fulllength": true,
          "description": "JSON condition format: { \"fieldName\": { \"op\": \"==\", \"value\": \"someValue\" } } or { \"fieldName\": \"exactValue\" }"
        },
        {
          "name": "requiredIf",
          "label": "Required If Condition",
          "type": "object",
          "fulllength": true,
          "required": false
        },
        {
          "name": "wizard",
          "label": "Connection Wizard Properties",
          "type": "object",
          "fulllength": true,
          "required": false,
          "description": "Configures a pop-up input generator wizard block for this metadata property.",
          "showIf": { "type": { "op": "in", "value": ["text", "textarea"] } },
          "properties": [
            {
              "name": "title",
              "label": "Wizard Window Title",
              "type": "text",
              "required": true,
              "description": "E.g., 'Database Connection Setup Wizard'"
            },
            {
              "name": "dependsOn",
              "label": "Depends On Field Name",
              "type": "text",
              "required": true,
              "description": "The exact parameter field name driving the choice array (e.g., 'DbProvider')"
            },
            {
              "name": "providers",
              "label": "Provider Engine Field Matrix mappings",
              "type": "object",
              "required": true,
              "description": "A dynamic payload configuration object mapping provider engine values (e.g., SqlServer, SQLite) to their required sub-fields array sets."
            }
          ]
        }
      ]
    }
  ]
}