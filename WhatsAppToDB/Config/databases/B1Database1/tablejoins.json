      "ITR1.SrcObjAbs=OPCH.DocEntry and ITR1.SrcObjTyp=OPCH.ObjType",
      "ITR1.SrcObjAbs=ORPC.DocEntry and ITR1.SrcObjTyp=ORPC.ObjType",
      "ITR1.SrcObjAbs=ORCT.DocEntry and ITR1.SrcObjTyp=ORCT.ObjType",
      "ITR1.SrcObjAbs=OVPM.DocEntry and ITR1.SrcObjTyp=OVPM.ObjType"
