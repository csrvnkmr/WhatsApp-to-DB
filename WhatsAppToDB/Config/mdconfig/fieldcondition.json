{
  "entity": "fieldcondition",
  "title": "Field Condition",

  "targetFile": "fieldcondition.json",

  "fields": [
    {
      "name": "fieldname",
      "label": "Field Name",
      "type": "text",
      "showinheader": true,
      "required": true,
      "unique":true
    },
    {
      "name": "datatype",
      "label": "Field data type",
      "showinheader": true,
      "type": "select",
      "required": true,
      "values": ["text", "number", "date", "boolean"]
    },
    {
      "name": "op",
      "label": "Operator",
      "showinheader": true,
      "type": "select",
      "required": true,
      "values": ["contains", "does not contain", "equals", 
                "does not equal", "starts with", "ends with"]
    },
    {
      "name": "value",
      "label": "Value",
      "showinheader": true,
      "type": "typeof(type)",
      "required": true
    }
  ]
}
